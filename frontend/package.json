{
  "name": "assetcore-frontend",
  "version": "0.2.0",
  "description": "AssetCore IMM-04 Decoupled Frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/free-dev-port.mjs 3000",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:test": "vue-tsc -p tsconfig.vitest.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gen:messages": "python3 ../scripts/gen_fe_messages.py"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "jsqr": "^1.4.0",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.7",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.19.21",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "vite": "^8.0.16",
    "@vitejs/plugin-vue": {
      "vite": "^8.0.16"
    }
  }
}
