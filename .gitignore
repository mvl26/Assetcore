# Scratch debug artifacts (factory/eval rớt ra — pattern hẹp, NEVER commit)
_scan_junk*.py
_cleanup_junk*.py
*.py.tmp.*
*.py.orig
# AssetCore FE build artifacts (generated by npm run build)
assetcore/public/frontend/
